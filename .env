# Use absolute paths so your data is always in a predictable spot
UPLOAD_LOCATION=/var/home/admin/immich-library
DB_DATA_LOCATION=/var/home/admin/immich-db

# Set your timezone so Immich logs and metadata are accurate
TZ=America/Vancouver

# Use a real password. Using 'postgres' is like leaving your house keys in the front door lock.
DB_PASSWORD=

# The Immich version to use. 'release' is usually best for stability.
IMMICH_VERSION=release

# The values below do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# SearXNG Variables
SEARXNG_VERSION=latest
SEARXNG_PORT=8123

# SearXNG Storage Paths (Absolute paths)
SEARXNG_CONFIG_DIR=/var/home/admin/searxng-config
SEARXNG_CORE_DATA=/var/home/admin/searxng-cache
SEARXNG_VALKEY_DATA=/var/home/admin/searxng-valkey-data
